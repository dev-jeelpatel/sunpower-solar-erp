  uploadedBy     Int?            @map("uploaded_by")
  uploadedAt     DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  job            InstallationJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedByUser User?           @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jobId], map: "job_photos_job_idx")
  @@map("job_photos")
}

