generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  entity    String   @db.VarChar(30)
  entityId  Int      @map("entity_id")
  action    String   @db.VarChar(60)
  detail    Json?
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity, entityId], map: "activity_entity_idx")
  @@map("activity_log")
}

model Customer {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(120)
  phone          String          @unique @db.VarChar(15)
  email          String?         @db.VarChar(150)
  address        String
  city           String?         @db.VarChar(80)
  pincode        String?         @db.VarChar(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  enquiries      Enquiry[]
  inventoryUnits InventoryUnit[]
  invoices       Invoice[]
  orders         Order[]
  tickets        Ticket[]

  @@map("customers")
}

model Dispatch {
  id             Int             @id @default(autoincrement())
  orderId        Int             @unique @map("order_id")
  status         DispatchStatus  @default(pending)
  vehicleNo      String?         @map("vehicle_no") @db.VarChar(20)
  dispatchedAt   DateTime?       @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventoryUnits InventoryUnit[]

  @@index([status])
  @@map("dispatches")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Enquiry {
  id                 Int           @id @default(autoincrement())
  customerName       String        @map("customer_name") @db.VarChar(120)
  phone              String        @db.VarChar(15)
  email              String?       @db.VarChar(150)
  address            String
  city               String?       @db.VarChar(80)
  requestedKw        Decimal       @map("requested_kw") @db.Decimal(3, 1)
  systemType         SystemType    @map("system_type")
  subsidyRequired    Boolean       @default(false) @map("subsidy_required")
  message            String?
  source             EnquirySource @default(web)
  status             EnquiryStatus @default(new)
  assignedTo         Int?          @map("assigned_to")
  customerId         Int?          @map("customer_id")
  shadowFreeSqft     Decimal?      @map("shadow_free_sqft") @db.Decimal(8, 1)
  monthlyBill        Decimal?      @map("monthly_bill") @db.Decimal(10, 2)
  gridSuitable       Boolean?      @map("grid_suitable")
  qualificationNotes String?       @map("qualification_notes")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignedToUser     User?         @relation(fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotes             Quote[]
  surveys            Survey[]

  @@index([assignedTo], map: "enquiries_assigned_idx")
  @@index([phone])
  @@index([status])
  @@map("enquiries")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InstallationJob {
  id            Int        @id @default(autoincrement())
  orderId       Int        @unique @map("order_id")
  status        JobStatus  @default(unscheduled)
  scheduledDate DateTime?  @map("scheduled_date") @db.Date
  startedAt     DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?  @map("finished_at") @db.Timestamptz(6)
  confirmedKw   Decimal?   @map("confirmed_kw") @db.Decimal(3, 1)
  notes         String?
  signerName    String?    @map("signer_name") @db.VarChar(100)
  signatureData String?    @map("signature_data")
  signedAt      DateTime?  @map("signed_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order         Order      @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobCrew       JobCrew[]
  jobPhotos     JobPhoto[]

  @@index([status, scheduledDate], map: "jobs_status_idx")
  @@map("installation_jobs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InventoryUnit {
  id                     Int            @id @default(autoincrement())
  productId              Int            @map("product_id")
  serialNo               String         @unique @map("serial_no") @db.VarChar(40)
  status                 UnitStatus     @default(in_stock)
  poId                   Int?           @map("po_id")
  dispatchId             Int?           @map("dispatch_id")
  orderId                Int?           @map("order_id")
  customerId             Int?           @map("customer_id")
  warrantyStart          DateTime?      @map("warranty_start") @db.Date
  warrantyEnd            DateTime?      @map("warranty_end") @db.Date
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispatch               Dispatch?      @relation(fields: [dispatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order                  Order?         @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  po                     PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product                Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticketsReplacementUnit Ticket[]       @relation("tickets_replacement_unit_idToinventory_units")
  ticketsUnit            Ticket[]       @relation("tickets_unit_idToinventory_units")

  @@index([customerId], map: "units_customer_idx")
  @@index([dispatchId], map: "units_dispatch_idx")
  @@index([productId, status], map: "units_product_status_idx")
  @@map("inventory_units")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  description String  @db.VarChar(200)
  quantity    Decimal @db.Decimal(8, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoiceId], map: "invoice_items_invoice_idx")
  @@map("invoice_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Invoice {
  id           Int           @id @default(autoincrement())
  invoiceNo    String        @unique @default(dbgenerated("((('INV-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('invoice_seq'::regclass))::text, 4, '0'::text))")) @map("invoice_no") @db.VarChar(20)
  kind         InvoiceKind
  orderId      Int?          @map("order_id")
  ticketId     Int?          @map("ticket_id")
  customerId   Int           @map("customer_id")
  status       InvoiceStatus @default(sent)
  subtotal     Decimal       @db.Decimal(12, 2)
  taxAmount    Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  issuedAt     DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issued_at") @db.Date
  dueDate      DateTime      @default(dbgenerated("(CURRENT_DATE + 15)")) @map("due_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  invoiceItems InvoiceItem[]
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_ticket_fk")
  payments     Payment[]

  @@index([customerId], map: "invoices_customer_idx")
  @@index([orderId], map: "invoices_order_idx")
  @@index([status])
  @@index([ticketId], map: "invoices_ticket_idx")
  @@map("invoices")
}

model JobCrew {
  jobId  Int             @map("job_id")
  userId Int             @map("user_id")
  job    InstallationJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([jobId, userId])
  @@index([userId], map: "job_crew_user_idx")
  @@map("job_crew")
}

model JobPhoto {
  id             Int             @id @default(autoincrement())
  jobId          Int             @map("job_id")
