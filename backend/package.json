{
  "name": "sunpower-backend",
  "version": "1.0.0",
  "description": "SunPower Solar Installation Management System - REST API (Express + PostgreSQL)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed/seed.ts",
    "db:embedded": "tsx scripts/dev-db.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.4",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
